# HireFlow AI Backend Environment
ENVIRONMENT=development
DATABASE_URL=sqlite:///./hireflow.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
SECRET_KEY=hireflow-super-secret-jwt-key-change-in-production-2026

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Storage
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage/cvs
GOOGLE_DRIVE_FOLDER_ID=

# n8n Automation
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=hireflow-n8n-webhook-secret

